# Скопируйте в .env и подставьте свои значения.
# .env в git не попадает (см. .gitignore). Настоящих секретов здесь нет.

# --- БД (async — для API, sync-производная — для Celery-воркера) ---
DATABASE_URL=postgresql+asyncpg://orderflow:orderflow@localhost:5432/orderflow

# --- Авторизация ---
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
ALGORITHM=HS256
CORS_ORIGINS=["http://localhost:3000"]

# --- Celery / Redis ---
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CELERY_ALWAYS_EAGER=false
CELERY_TASK_EAGER_PROPAGATES=false
# Отдельная БД Redis для кэша и шины событий
REDIS_URL=redis://localhost:6379/2
CACHE_TTL_SECONDS=60

# --- Задачи ---
INVOICE_DIR=data/invoices
STALE_ORDER_DAYS=30
ORDER_EMAIL_ENABLED=true

DEBUG=false
